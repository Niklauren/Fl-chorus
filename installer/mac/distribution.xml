<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>FL Chorus</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>

    <choice id="vst3" title="VST3" description="/Library/Audio/Plug-Ins/VST3" start_selected="true">
        <pkg-ref id="com.mikitalaurenau.flchorus.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="/Library/Audio/Plug-Ins/Components" start_selected="true">
        <pkg-ref id="com.mikitalaurenau.flchorus.au"/>
    </choice>

    <pkg-ref id="com.mikitalaurenau.flchorus.vst3" version="1.0.0" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.mikitalaurenau.flchorus.au" version="1.0.0" onConclusion="none">au.pkg</pkg-ref>
</installer-gui-script>
